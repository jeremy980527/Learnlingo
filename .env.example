# === Supabase ===
# 專案設定 → API 找到以下兩組值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 專案設定 → API → service_role key（僅伺服器端使用，勿外流／勿加上 NEXT_PUBLIC_ 前綴）
SUPABASE_SERVICE_ROLE_KEY=

# === 資料庫（Prisma） ===
# Supabase 專案設定 → Database → Connection string（建議使用 Connection Pooling 的 URI）
DATABASE_URL=

# === AI（Claude API） ===
# 未設定時，系統會自動改用內建的離線規則式引擎（mock provider）產生學習地圖，
# 方便在尚未申請 API Key 前先行開發與展示。
ANTHROPIC_API_KEY=
# 預設 claude-sonnet-5，如需更換模型可覆寫
ANTHROPIC_MODEL=claude-sonnet-5
